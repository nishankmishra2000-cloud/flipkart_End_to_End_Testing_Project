{
  "info": {
    "name": "Flipkart QA Project - Product API (DummyJSON)",
    "description": "API test collection demonstrating REST methodology against DummyJSON's product catalog, substituting for Flipkart's non-public API. See 03-API-Testing/README.md for rationale.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET All Products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response has products array', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.products).to.be.an('array').that.is.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET Single Product",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/products/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Product id matches', () => pm.response.json().id === 1);",
              "pm.test('Has a title and positive price', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.title).to.be.a('string').that.is.not.empty;",
              "  pm.expect(json.price).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET Single Product - Invalid ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/products/999999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 404 for invalid id', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET Search Products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/products/search?q=phone"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Results relate to query', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.products.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST Add Product",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/products/add",
        "body": {
          "mode": "raw",
          "raw": "{ \"title\": \"Flipkart QA Test Product\", \"price\": 999 }"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
              "pm.test('Echoes submitted title', () => pm.response.json().title === 'Flipkart QA Test Product');",
              "pm.test('Has a new id', () => pm.response.json().id !== undefined);"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT Update Product",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/products/1",
        "body": {
          "mode": "raw",
          "raw": "{ \"title\": \"Updated Title\" }"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Title is updated in response', () => pm.response.json().title === 'Updated Title');"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH Update Product",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/products/1",
        "body": {
          "mode": "raw",
          "raw": "{ \"price\": 1299 }"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Price is updated in response', () => pm.response.json().price === 1299);"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE Product",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/products/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('isDeleted flag is true', () => pm.response.json().isDeleted === true);"
            ]
          }
        }
      ]
    }
  ]
}
